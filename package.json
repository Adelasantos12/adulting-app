{
  "name": "seradulto-app",
  "version": "1.0.0",
  "description": "Aplicación de supervivencia para jóvenes adultos - SerAdulto",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o public/css/tailwind.css --minify",
    "vendor": "mkdir -p public/vendor && cp node_modules/lucide/dist/umd/lucide.min.js public/vendor/lucide.min.js",
    "build:web": "npm run vendor && npm run build:css"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true,
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "lucide": "1.63.0",
    "tailwindcss": "3.4.19"
  }
}
